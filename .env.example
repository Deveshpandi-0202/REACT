# GrocerApp - Environment variables
# Copy this file to .env and customize if needed:
#   cp .env.example .env

# Secret key for JWT token signing (change this in production!)
JWT_SECRET_KEY=grocerapp-jwt-secret-key-change-in-production-2024

# Port for the frontend (browser access)
FRONTEND_PORT=8080

# Production database connection (Render provides this automatically)
# For local Docker with production DB: set this to your PostgreSQL URL
# For local Docker with SQLite: leave unset (defaults to local SQLite file)
# DATABASE_URL=postgresql://user:pass@host:5432/blinkit

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
